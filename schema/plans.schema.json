{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "letterlab-plans-1",
  "title": "Activities and journeys (content/plans.json)",
  "type": "object",
  "required": ["schema", "activities", "journeys"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "letterlab-plans-1" },
    "note": { "type": "string" },
    "activities": { "type": "object", "additionalProperties": false, "patternProperties": { "^[a-z-]+$": { "type": "string", "pattern": "^js/kid/activities/[a-z-]+\\.js$" } } },
    "journeys": { "type": "object", "additionalProperties": false, "patternProperties": { "^[a-z-]+$": { "type": "array", "minItems": 1, "items": { "type": "string" } } } }
  }
}
